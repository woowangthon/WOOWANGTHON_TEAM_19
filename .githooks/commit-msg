#!/bin/sh
# 커밋 메시지 첫 줄에 작업 번호(TK-n)가 없으면 거부한다.
# 노션 작업 DB가 이 번호로 PR·커밋을 연결한다. (팀 결정 2026-10-28)
# 예외: 머지 커밋, fixup!/squash!, 번호가 필요 없는 메시지는 "chore(no-tk):" 로 시작.
# 설치: git config core.hooksPath .githooks  (클론한 사람마다 한 번)

msg_file="$1"
first_line=$(sed -n '1p' "$msg_file")

case "$first_line" in
  Merge\ *|fixup!*|squash!*|"chore(no-tk):"*) exit 0 ;;
esac

if printf '%s' "$first_line" | grep -Eq 'TK-[0-9]+'; then
  exit 0
fi

cat >&2 <<'EOF'
커밋 거부: 첫 줄에 작업 번호가 없습니다.
  형식: TK-36: 학생 화면 초안
  번호가 정말 없는 커밋이면: chore(no-tk): 메시지
노션 작업 DB(팀 허브 v3 → 작업실)에서 번호를 확인하세요.
EOF
exit 1
