@@ -4,19 +4,26 @@
 
 const BASE = (import.meta.env.VITE_API_BASE as string | undefined) ?? 'http://localhost:8000';
 
+// [테스트 패치] 백엔드 데모 신원 헤더. 보호자 화면(#/guardian…)이면 guardian, 나머지는 child.
+function demoHeaders(): Record<string, string> {
+  return location.hash.startsWith('#/guardian')
+    ? { 'X-Demo-Role': 'guardian', 'X-Demo-Actor': 'demo-guardian-minsu' }
+    : { 'X-Demo-Role': 'child', 'X-Demo-Actor': 'demo-child-minsu' };
+}
+
 async function call<T>(method: 'GET' | 'POST' | 'PUT' | 'DELETE', path: string, body?: unknown): Promise<T> {
   let res: Response;
   try {
     res = await fetch(BASE + path, {
       method,
-      headers: body !== undefined ? { 'Content-Type': 'application/json' } : undefined,
+      headers: { ...demoHeaders(), ...(body !== undefined ? { 'Content-Type': 'application/json' } : {}) },
       body: body !== undefined ? JSON.stringify(body) : undefined,
     });
   } catch {
     throw new Error('서버에 연결하지 못했어요. 인터넷 연결을 확인해 주세요.');
   }
   if (!res.ok) {
-    const detail = await res.json().then((j) => j?.detail as string | undefined).catch(() => undefined);
+    const detail = await res.json().then((j) => (j?.message ?? j?.detail) as string | undefined).catch(() => undefined);
     throw new Error(detail ?? `서버 오류가 났어요 (${res.status})`);
   }
   return (res.status === 204 ? undefined : await res.json()) as T;
